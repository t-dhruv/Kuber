# =============================================================================
# Kuber — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# In production (docker-compose.prod.yml) this points to the postgres service.
# The password here must match POSTGRES_PASSWORD below.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://kuber:replace-with-a-long-random-password@postgres:5432/kuber_db

# Password used by the postgres service in docker-compose.prod.yml
POSTGRES_PASSWORD=

# Contributors only — not used by a running Instance.
# The database `npm run test:db` runs against. Leave unset and it defaults to
# DATABASE_URL with `_test` appended to the database name. The name must end in
# `_test`: that suite truncates every table it finds.
# TEST_DATABASE_URL=

# -----------------------------------------------------------------------------
# Auth — JWT secrets
# Generate with: openssl rand -base64 64
# Both must be at least 64 characters. Keep them different from each other.
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=9002
NODE_ENV=production

# The public URL of your Kuber instance (no trailing slash).
# Used for CORS and email links.
CLIENT_URL=http://localhost

# Number of reverse-proxy hops in front of the API. Determines which
# X-Forwarded-For entry is treated as the real client IP, which is what
# rate limiting buckets on.
#   1 = the bundled Nginx stack (default, correct for `make prod-up`)
#   0 = API exposed directly with no reverse proxy
# Set this to the actual number of proxies you run. Too high a value lets
# clients forge their IP and bypass rate limits.
TRUST_PROXY=1

# Whether someone with no invite can register on this Instance.
#
# Leave it empty for the default, which is what you want: registration is open
# until the first household exists — long enough for you to claim your own
# Instance — and closes by itself after that. Invite links keep working either
# way, so this is not how you add your partner; Settings → Household is.
#
#   (empty)  open until the first household exists, then closed
#   true     open permanently — only if you understand that anyone who can reach
#            this Instance can then register on it
#   false    closed, including on an empty Instance
#
# Do not set this to false before you have signed up, or nobody can claim the
# Instance without editing the database.
ALLOW_SIGNUP=

# Whether the refresh cookie carries the `Secure` attribute. Defaults to true.
#
# Leave it alone if you reach Kuber over HTTPS — which you should, if the
# Instance is reachable from the internet.
#
# Set it to false ONLY for a trusted LAN Instance served over plain HTTP, e.g.
# http://192.168.1.50. Browsers discard Secure cookies over plain HTTP (they
# exempt localhost), so with it left on you would log in successfully and then
# be silently signed out fifteen minutes later, when the access token expires.
#
# The trade-off is real: with this off, the refresh token crosses your network in
# the clear and anyone on that network can read it. The server logs a warning at
# boot to that effect. The cookie stays HttpOnly either way.
COOKIE_SECURE=true

# Rate limits are per client IP. Increase these behind trusted private deployments
# or lower them for public multi-user instances.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=2000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50
# Logo lookups are unauthenticated by necessity (the client loads them as
# <img src>, which cannot send a Bearer token) and a cache miss triggers an
# outbound fetch, so they are limited far more tightly than the general API.
LOGO_RATE_LIMIT_WINDOW_MS=60000
LOGO_RATE_LIMIT_MAX=120

# -----------------------------------------------------------------------------
# Email (SMTP) — optional
# Leave blank to disable email features (password reset, notifications).
# Works with any SMTP provider: Gmail, Mailgun, Postmark, self-hosted, etc.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<App Password from Google Account settings>
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Kuber <noreply@yourdomain.com>

# -----------------------------------------------------------------------------
# Email (Resend) — alternative to SMTP, takes priority if RESEND_API_KEY is set
# Get your API key at https://resend.com
# Recommended for production: simpler setup, better deliverability than raw SMTP.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=Kuber <noreply@yourdomain.com>

# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# Observability (optional)
#
# In production these are only read by the opt-in overlay, which is not part of
# the default three-service stack:
#   docker compose -f docker-compose.prod.yml -f docker-compose.observability.yml up -d
#
# In development the equivalent is `--profile observability`.
# Set both before enabling either; the overlay refuses to start without them.
# -----------------------------------------------------------------------------
GRAFANA_USER=
GRAFANA_PASSWORD=

# -----------------------------------------------------------------------------
# Published HTTP port (production only)
#
# The client service is the edge and publishes this port. Defaults to 80.
# Change it if something else already owns 80, or if you are running Kuber
# behind your own reverse proxy on a different port.
# -----------------------------------------------------------------------------
HTTP_PORT=80

# -----------------------------------------------------------------------------
# Image tag (production only)
#
# Which published version the server and client services pull. Left empty here
# on purpose: a version baked into this file would go stale the moment a newer
# one ships, and quietly install the old one for anyone who copied it.
#
# Empty falls back to `latest`, which only ever points at a stable release.
# While Kuber is in beta there is no stable release yet, so you must set this
# or the stack cannot resolve an image:
#
#   IMAGE_TAG=1.0.0-beta
#
# Note there is no `v` prefix — the git tag `v1.2.3` publishes images tagged
# `1.2.3`. See docs/02-how-to/self-hosting.md.
# -----------------------------------------------------------------------------
IMAGE_TAG=

# -----------------------------------------------------------------------------
# AI Advisor
# Users configure their own provider (Claude, OpenAI, Gemini, Ollama,
# OpenRouter, or None) and API key inside the app Settings page.
# Keys are stored encrypted in the database using AI_ENCRYPTION_KEY.
#
# Generate with: openssl rand -hex 32
# Must be exactly 64 hex characters (32 bytes). REQUIRED in production because
# AI keys, IMAP connector passwords, and webhook signing secrets are encrypted.
# -----------------------------------------------------------------------------
AI_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Web Push Notifications (optional)
# Generate VAPID keys with: npx web-push generate-vapid-keys
# Leave blank to disable push notifications.
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI shown to push services (mailto: or https:). Defaults to mailto:admin@kuber.app
VAPID_SUBJECT=

# -----------------------------------------------------------------------------
# Logging
# Controls server log verbosity. One of: trace, debug, info, warn, error, fatal
# Defaults to "debug" in development and "info" in production.
# -----------------------------------------------------------------------------
LOG_LEVEL=

# -----------------------------------------------------------------------------
# 2FA (TOTP)
# The issuer name shown in authenticator apps (Google Authenticator, Authy, etc.)
# Defaults to "Kuber" if not set.
# -----------------------------------------------------------------------------
TOTP_APP_NAME=Kuber
