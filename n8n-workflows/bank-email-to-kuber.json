{
  "id": "bank-email-to-kuber",
  "name": "Bank Email → Kuber Import",
  "active": false,
  "version": 1,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "node-imap-trigger",
      "name": "Watch Bank Email",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [240, 300],
      "credentials": {
        "imap": {
          "id": "imap-credential-id",
          "name": "Bank Email IMAP"
        }
      },
      "parameters": {
        "mailbox": "INBOX",
        "action": "read",
        "downloadAttachments": true,
        "options": {
          "allowUnauthorizedCerts": false,
          "forceReconnect": 60
        }
      }
    },
    {
      "id": "node-filter-attachments",
      "name": "Filter CSV/PDF Attachments",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.attachments ? $json.attachments.length : 0 }}",
              "operation": "largerEqual",
              "value2": "1"
            }
          ]
        }
      }
    },
    {
      "id": "node-extract-attachment",
      "name": "Extract Attachment",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [680, 260],
      "parameters": {
        "operation": "text",
        "binaryPropertyName": "={{ $json.attachments[0].content }}",
        "options": {}
      }
    },
    {
      "id": "node-post-to-kuber",
      "name": "POST to Kuber Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [900, 260],
      "credentials": {
        "httpHeaderAuth": {
          "id": "kuber-auth-credential-id",
          "name": "Kuber API Token"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "={{ $env.KUBER_WEBHOOK_URL }}/api/v1/import/webhook",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "parameters": [
            {
              "name": "accountId",
              "value": "REPLACE_WITH_YOUR_ACCOUNT_ID"
            },
            {
              "name": "source",
              "value": "bank-email"
            },
            {
              "name": "transactions",
              "value": "={{ $json.transactions }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    }
  ],
  "connections": {
    "Watch Bank Email": {
      "main": [
        [
          {
            "node": "Filter CSV/PDF Attachments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter CSV/PDF Attachments": {
      "main": [
        [
          {
            "node": "Extract Attachment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Attachment": {
      "main": [
        [
          {
            "node": "POST to Kuber Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
