{
  "id": "market-news-to-intel",
  "name": "Market News → Kuber Intel Feed",
  "active": false,
  "version": 1,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "node-schedule",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      }
    },
    {
      "id": "node-yahoo-rss",
      "name": "Yahoo Finance RSS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 200],
      "parameters": {
        "method": "GET",
        "url": "https://finance.yahoo.com/news/rssindex",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      }
    },
    {
      "id": "node-marketwatch-rss",
      "name": "MarketWatch RSS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 340],
      "parameters": {
        "method": "GET",
        "url": "https://feeds.content.dowjones.io/public/rss/mw_topstories",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      }
    },
    {
      "id": "node-reuters-rss",
      "name": "Reuters Business RSS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 480],
      "parameters": {
        "method": "GET",
        "url": "https://feeds.reuters.com/reuters/businessNews",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      }
    },
    {
      "id": "node-parse-xml",
      "name": "Parse RSS XML",
      "type": "n8n-nodes-base.xml",
      "typeVersion": 1,
      "position": [680, 340],
      "parameters": {
        "operation": "parse",
        "dataPropertyName": "data"
      }
    },
    {
      "id": "node-filter-tickers",
      "name": "Filter by Watch Tickers",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 1,
      "position": [900, 340],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ (() => { const tickers = ($env.KUBER_WATCH_TICKERS || '').split(',').map(t => t.trim().toUpperCase()).filter(Boolean); const title = ($json.rss?.channel?.item?.[0]?.title || $json.title || '').toUpperCase(); return tickers.some(t => title.includes(t)) ? 'match' : '' })() }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      }
    },
    {
      "id": "node-ai-summarize",
      "name": "AI Summarize",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [1120, 340],
      "parameters": {
        "operation": "text",
        "prompt": "=Summarize this financial news article in 2-3 sentences and classify sentiment as bullish, bearish, or neutral.\n\nTitle: {{ $json.rss?.channel?.item?.[0]?.title || $json.title || 'Unknown' }}\nDescription: {{ $json.rss?.channel?.item?.[0]?.description || $json.description || '' }}\n\nRespond with JSON only: { \"title\": \"...\", \"summary\": \"...\", \"sentiment\": \"bullish|bearish|neutral\" }",
        "options": {
          "model": "gpt-3.5-turbo",
          "maxTokens": 300
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "openai-credential-id",
          "name": "OpenAI"
        }
      }
    },
    {
      "id": "node-post-intel",
      "name": "POST to Kuber Intel Feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1340, 340],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.KUBER_WEBHOOK_URL }}/api/v1/investment-intel/feed",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.KUBER_API_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ (() => { let parsed = {}; try { parsed = JSON.parse($json.message?.content || '{}'); } catch(e) {} return { source: 'news', title: parsed.title || 'News Update', summary: parsed.summary || '', sentiment: parsed.sentiment || 'neutral' }; })() }}"
      }
    }
  ],
  "connections": {
    "Every 6 Hours": {
      "main": [
        [
          { "node": "Yahoo Finance RSS", "type": "main", "index": 0 },
          { "node": "MarketWatch RSS", "type": "main", "index": 0 },
          { "node": "Reuters Business RSS", "type": "main", "index": 0 }
        ]
      ]
    },
    "Yahoo Finance RSS": {
      "main": [[{ "node": "Parse RSS XML", "type": "main", "index": 0 }]]
    },
    "MarketWatch RSS": {
      "main": [[{ "node": "Parse RSS XML", "type": "main", "index": 0 }]]
    },
    "Reuters Business RSS": {
      "main": [[{ "node": "Parse RSS XML", "type": "main", "index": 0 }]]
    },
    "Parse RSS XML": {
      "main": [[{ "node": "Filter by Watch Tickers", "type": "main", "index": 0 }]]
    },
    "Filter by Watch Tickers": {
      "main": [[{ "node": "AI Summarize", "type": "main", "index": 0 }]]
    },
    "AI Summarize": {
      "main": [[{ "node": "POST to Kuber Intel Feed", "type": "main", "index": 0 }]]
    }
  }
}
