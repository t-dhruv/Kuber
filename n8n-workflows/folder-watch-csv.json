{
  "id": "folder-watch-csv",
  "name": "Folder Watch CSV → Kuber Import",
  "active": false,
  "version": 1,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "node-local-file-trigger",
      "name": "Watch /bank-drop/ Folder",
      "type": "n8n-nodes-base.localFileTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {
        "path": "/bank-drop",
        "events": ["add"],
        "options": {
          "awaitWriteFinish": true,
          "ignored": "**/*.!(csv)"
        }
      }
    },
    {
      "id": "node-read-file",
      "name": "Read CSV File",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [460, 300],
      "parameters": {
        "filePath": "={{ $json.path }}"
      }
    },
    {
      "id": "node-parse-csv",
      "name": "Parse CSV",
      "type": "n8n-nodes-base.spreadsheetFile",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "operation": "fromFile",
        "binaryPropertyName": "data",
        "options": {
          "headerRow": true,
          "includeEmptyLines": false
        }
      }
    },
    {
      "id": "node-post-to-kuber",
      "name": "POST to Kuber Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [900, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "kuber-auth-credential-id",
          "name": "Kuber API Token"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "={{ $env.KUBER_WEBHOOK_URL }}/api/v1/import/webhook",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "parameters": [
            {
              "name": "accountId",
              "value": "REPLACE_WITH_YOUR_ACCOUNT_ID"
            },
            {
              "name": "source",
              "value": "folder-watch"
            },
            {
              "name": "transactions",
              "value": "={{ $items().map(item => ({ date: item.json.Date || item.json.date, description: item.json.Description || item.json.description, amount: parseFloat(item.json.Amount || item.json.amount) })) }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    }
  ],
  "connections": {
    "Watch /bank-drop/ Folder": {
      "main": [
        [
          {
            "node": "Read CSV File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read CSV File": {
      "main": [
        [
          {
            "node": "Parse CSV",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse CSV": {
      "main": [
        [
          {
            "node": "POST to Kuber Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
