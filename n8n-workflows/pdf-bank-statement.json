{
  "id": "pdf-bank-statement",
  "name": "PDF Bank Statement → Kuber Import",
  "active": false,
  "version": 1,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "node-manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {}
    },
    {
      "id": "node-read-binary",
      "name": "Read PDF File",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [460, 300],
      "parameters": {
        "filePath": "/home/node/workflows/statement.pdf"
      }
    },
    {
      "id": "node-extract-pdf",
      "name": "Extract from PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [680, 300],
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "data",
        "options": {}
      }
    },
    {
      "id": "node-parse-transactions",
      "name": "Parse Transaction Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300],
      "parameters": {
        "jsCode": "// Parse extracted PDF text into transaction rows\n// Adjust regex to match your bank statement format\nconst text = $input.item.json.text || '';\nconst lines = text.split('\\n').filter(l => l.trim());\n\nconst transactions = [];\nconst dateRegex = /^(\\d{1,2}[\\/\\-]\\d{1,2}[\\/\\-]\\d{2,4})/;\nconst amountRegex = /(-?\\$?[\\d,]+\\.\\d{2})\\s*$/;\n\nfor (const line of lines) {\n  const dateMatch = line.match(dateRegex);\n  const amountMatch = line.match(amountRegex);\n  if (dateMatch && amountMatch) {\n    const description = line\n      .replace(dateMatch[0], '')\n      .replace(amountMatch[0], '')\n      .trim();\n    const amount = parseFloat(amountMatch[1].replace(/[$,]/g, ''));\n    transactions.push({\n      date: dateMatch[1],\n      description,\n      amount,\n    });\n  }\n}\n\nreturn [{ json: { transactions, count: transactions.length } }];"
      }
    },
    {
      "id": "node-post-import",
      "name": "POST to Kuber Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1120, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.KUBER_WEBHOOK_URL }}/api/v1/import/webhook",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.KUBER_API_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ { transactions: $json.transactions } }}"
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Read PDF File", "type": "main", "index": 0 }]]
    },
    "Read PDF File": {
      "main": [[{ "node": "Extract from PDF", "type": "main", "index": 0 }]]
    },
    "Extract from PDF": {
      "main": [[{ "node": "Parse Transaction Rows", "type": "main", "index": 0 }]]
    },
    "Parse Transaction Rows": {
      "main": [[{ "node": "POST to Kuber Webhook", "type": "main", "index": 0 }]]
    }
  }
}
