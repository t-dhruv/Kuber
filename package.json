{
  "name": "kuber",
  "version": "1.1.0-beta",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "dotenv -e .env -- turbo dev",
    "build": "dotenv -e .env -- turbo build",
    "prepare": "git config core.hooksPath .githooks || true",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "dotenv -e .env -- turbo lint",
    "typecheck": "dotenv -e .env -- turbo typecheck",
    "db:generate": "dotenv -e .env -- turbo run db:generate --filter=@kuber/server",
    "test": "dotenv -e .env -- turbo test",
    "test:db": "dotenv -e .env -- turbo run test:db --filter=@kuber/server",
    "test:coverage": "dotenv -e .env -- sh -c \"npm run test:coverage --workspace=server && npm run test:coverage --workspace=@kuber/client\"",
    "test:e2e": "dotenv -e .env -- playwright test",
    "test:smoke": "dotenv -e .env -- playwright test --grep @smoke",
    "db:migrate": "dotenv -e .env -- turbo run db:migrate --filter=@kuber/server",
    "db:seed": "dotenv -e .env -- turbo run db:seed --filter=@kuber/server",
    "db:studio": "dotenv -e .env -- turbo run db:studio --filter=@kuber/server",
    "release": "bash scripts/release.sh"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.9.0",
    "turbo": "^2.9.4",
    "typescript-eslint": "^8.58.0"
  },
  "overrides": {
    "path-to-regexp": "^0.1.13",
    "semver": "^7.7.4",
    "serialize-javascript": "^7.0.5",
    "follow-redirects": "^1.16.0",
    "postcss": "^8.5.10",
    "esbuild": "^0.28.1",
    "uuid": "^14.0.0",
    "workbox-build": "^7.4.0",
    "brace-expansion": "^5.0.9",
    "@babel/core": "^7.29.2",
    "@rollup/plugin-terser": "^0.4.4"
  }
}
