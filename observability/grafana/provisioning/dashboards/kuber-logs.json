{
  "title": "Kuber — Logs",
  "uid": "kuber-logs",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "All Logs",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "dedupStrategy": "none", "showTime": true, "sortOrder": "Descending" },
      "targets": [
        {
          "expr": "{container_name=\"kuber_server\"}",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Errors Only",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "dedupStrategy": "none", "showTime": true, "sortOrder": "Descending" },
      "targets": [
        {
          "expr": "{container_name=\"kuber_server\", level=\"error\"}",
          "legendFormat": ""
        }
      ]
    }
  ]
}
