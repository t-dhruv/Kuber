{
  "name": "@kuber/client",
  "private": true,
  "version": "1.2.0-beta",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../.env -- vite",
    "build": "dotenv -e ../.env -- sh -c \"tsc -b && vite build\"",
    "preview": "dotenv -e ../.env -- vite preview",
    "lint": "dotenv -e ../.env -- eslint .",
    "typecheck": "dotenv -e ../.env -- tsc --noEmit",
    "test": "dotenv -e ../.env -- vitest run",
    "test:coverage": "dotenv -e ../.env -- vitest run --coverage"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@kuber/shared": "*",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-query-devtools": "^5.96.2",
    "axios": "^1.15.2",
    "emoji-picker-react": "^5.1.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv-cli": "^11.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.0"
  }
}
