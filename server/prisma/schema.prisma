  @@map("transfer_groups")
}

model TransactionLinkType {
  id      String            @id @default(cuid())
  name    String            @unique
  inward  String
  outward String
  links   TransactionLink[]

  @@map("transaction_link_types")
}

model TransactionLink {
  id          String   @id @default(cuid())
  householdId String
  linkTypeId  String
  fromId      String
  toId        String
  createdAt   DateTime @default(now())

  household Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  linkType  TransactionLinkType @relation(fields: [linkTypeId], references: [id])
  from      TransactionJournal  @relation("LinksFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        TransactionJournal  @relation("LinksTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, linkTypeId])
  @@index([householdId])
  @@map("transaction_links")
}

model ObjectGroup {
