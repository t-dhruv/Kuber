  name        String
  entityType  String // "account" | "category" | "budget"
  color       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  accounts   Account[]
  categories Category[]
  budgets    Budget[]

  @@index([householdId, entityType])
  @@map("object_groups")
}

model LogoCache {
  id        String   @id @default(cuid())
  type      String // "bank" | "merchant"
  key       String // normalized name (lowercase, trimmed)
  logoData  Bytes? // null = confirmed no logo found (negative cache)
  mimeType  String?
  source    String? // "clearbit" | "duckduckgo"
  fetchedAt DateTime @default(now())

  @@unique([type, key])
  @@map("logo_cache")
}
