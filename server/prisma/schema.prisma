generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String            @id @default(cuid())
  email               String            @unique
  passwordHash        String
  firstName           String
  lastName            String
  avatar              String?
  timezone            String            @default("America/New_York")
  theme               String            @default("system")
  // 2FA
  totpSecret          String?
  totpEnabled         Boolean           @default(false)
  backupCodes         String[]          @default([])
  // Account lockout
  failedLoginAttempts Int               @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  householdMembers    HouseholdMember[]
  preferences         UserPreference[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  apiTokens           ApiToken[]

  @@map("users")
}

model Household {
  id                       String                    @id @default(cuid())
  name                     String
  currency                 String                    @default("USD")
  fiscalYearStart          Int                       @default(1)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  members                  HouseholdMember[]
  accounts                 Account[]
  categories               Category[]
  budgets                  Budget[]
  bills                    Bill[]
  recurringItems           RecurringItem[]
  goals                    Goal[]
  rules                    Rule[]
  merchants                Merchant[]
  tags                     Tag[]
  invites                  HouseholdInvite[]
  aiConfig                 AiConfig?
  conversations            Conversation[]
  netWorthSnapshots        NetWorthSnapshot[]
  accountBalanceSnapshots  AccountBalanceSnapshot[]
  reportingSnapshots       ReportingSnapshot[]
  reportingRollups         ReportingRollup[]
  savedReports             SavedReport[]
  wealthAiCache            WealthAiCache?
  duplicateDismissals      DuplicateDismissal[]
  reportSchedule           ReportSchedule?
  importHistory            ImportHistory[]
  operationCheckpoints     OperationCheckpoint[]
  notifications            Notification[]
  manualAssets             ManualAsset[]
  manualLiabilities        ManualLiability[]
  taxAccounts              TaxAccount[]
  apiTokens                ApiToken[]
  investmentIntel          InvestmentIntel[]
  pushSubscriptions        PushSubscription[]
  webhooks                 Webhook[]
  providerConnections      ProviderConnection[]
  transferGroups           TransferGroup[]
  transactionGroups        TransactionGroup[]
  transactionJournals      TransactionJournal[]
  ruleExecutionLogs        RuleExecutionLog[]
  categoryLearningExamples CategoryLearningExample[]
  ruleGroups               RuleGroup[]
  reconciliations          Reconciliation[]
  availableBudgets         AvailableBudget[]
  attachments              Attachment[]
  transactionLinks         TransactionLink[]
  objectGroups             ObjectGroup[]

  @@map("households")
}

model AiConfig {
  id              String    @id @default(cuid())
  householdId     String    @unique
  provider        String    @default("none") // "anthropic"|"openai"|"gemini"|"openrouter"|"none"
  model           String    @default("")
  encryptedApiKey String    @default("")
  baseUrl         String?
  headers         String? // JSON: {"key": "value"} for custom provider
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("ai_configs")
}

model EmailConfig {
  id           String   @id @default("singleton")
  provider     String   @default("none") // "resend" | "smtp" | "none"
  resendApiKey String   @default("") // encrypted
  resendFrom   String   @default("")
  smtpHost     String   @default("")
  smtpPort     Int      @default(587)
  smtpUser     String   @default("")
  smtpPass     String   @default("") // encrypted
  smtpFrom     String   @default("")
  updatedAt    DateTime @updatedAt

  @@map("email_config")
}

model Conversation {
  id          String                @id @default(cuid())
  householdId String
  userId      String
  title       String                @default("New conversation")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  messages    ConversationMessage[]
  household   Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, updatedAt])
  @@map("conversations")
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  role           String // "user"|"assistant"|"system"
  content        String
  tokenCount     Int?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

model HouseholdMember {
  id          String    @id @default(cuid())
  userId      String
  householdId String
  role        String    @default("member")
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@map("household_members")
}

model HouseholdInvite {
  id          String    @id @default(cuid())
  householdId String
  email       String
  token       String    @unique @default(cuid())
  role        String    @default("member")
  expiresAt   DateTime
  usedAt      DateTime?
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("household_invites")
}

model RefreshToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique // SHA-256 of the raw token
  familyId   String // shared across all rotations in a session
  userId     String
  expiresAt  DateTime
  rememberMe Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}

model Account {
  id                   String                   @id @default(cuid())
  householdId          String
  name                 String
  type                 String
  institution          String?
  institutionLogo      String?
  lastFour             String?
  balance              Float                    @default(0)
  balanceDecimal       Decimal?                 @db.Decimal(19, 4)
  currency             String                   @default("USD")
  creditLimit          Float?
  creditLimitDecimal   Decimal?                 @db.Decimal(19, 4)
  providerConnectionId String?
  isHidden             Boolean                  @default(false)
  excludeFromNetWorth  Boolean                  @default(false)
  excludeFromReports   Boolean                  @default(false)
  isDeleted            Boolean                  @default(false)
  lastSynced           DateTime?
  objectGroupId        String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  household            Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  providerConnection   ProviderConnection?      @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  objectGroup          ObjectGroup?             @relation(fields: [objectGroupId], references: [id], onDelete: SetNull)
  transactionEntries   TransactionEntry[]
  recurringItems       RecurringItem[]
  goals                Goal[]
  investmentHoldings   InvestmentHolding[]
  balanceSnapshots     AccountBalanceSnapshot[]
  taxAccounts          TaxAccount[]
  reconciliations      Reconciliation[]

  @@map("accounts")
}

model TransactionGroup {
  id          String               @id @default(cuid())
  householdId String
  title       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  household   Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  journals    TransactionJournal[]

  @@index([householdId, createdAt])
  @@map("transaction_groups")
}

model TransactionJournal {
  id                      String                   @id @default(cuid())
  householdId             String
  groupId                 String
  transactionType         String
  date                    DateTime
  description             String
  amountDecimal           Decimal                  @db.Decimal(19, 4)
  currencyCode            String                   @default("USD")
  categoryId              String?
  merchantId              String?
  notes                   String?
  isPending               Boolean                  @default(false)
  isReconciled            Boolean                  @default(false)
  reconciledAt            DateTime?
  needsReview             Boolean                  @default(false)
  isHidden                Boolean                  @default(false)
  isRecurring             Boolean                  @default(false)
  isSplit                 Boolean                  @default(false)
  isDeleted               Boolean                  @default(false)
  aiSuggestedCategoryId   String?
  aiSuggestedCategoryName String?
  aiSuggestionConfidence  Float?
  order                   Int                      @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  household               Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  group                   TransactionGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  category                Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  merchant                Merchant?                @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  aiSuggestedCategory     Category?                @relation("JournalAiSuggestedCategory", fields: [aiSuggestedCategoryId], references: [id], onDelete: SetNull)
  entries                 TransactionEntry[]
  tags                    JournalTag[]
  meta                    TransactionJournalMeta[]
  ruleExecutionLogs       RuleExecutionLog[]
  attachments             Attachment[]
  billPaidPeriods         BillPaidPeriod[]
  transactionTags         TransactionTag[]
  splits                  TransactionSplit[]
  linksFrom               TransactionLink[]        @relation("LinksFrom")
  linksTo                 TransactionLink[]        @relation("LinksTo")
  goalAllocations         GoalAllocation[]

  @@index([householdId, date])
  @@index([householdId, transactionType, date])
  @@index([groupId])
  @@index([categoryId])
  @@index([merchantId])
  @@index([householdId, isDeleted, date])
  @@map("transaction_journals")
}

model TransactionEntry {
  id            String             @id @default(cuid())
  journalId     String
  accountId     String
  amountDecimal Decimal            @db.Decimal(19, 4)
  currencyCode  String             @default("USD")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  journal       TransactionJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account       Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([journalId])
  @@index([accountId])
  @@map("transaction_entries")
}

model TransactionJournalMeta {
  id        String             @id @default(cuid())
  journalId String
  name      String
  value     String
  journal   TransactionJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([journalId, name])
  @@map("transaction_journal_meta")
}

model Category {
  id                  String                    @id @default(cuid())
  householdId         String
  name                String
  icon                String?
  type                String
  groupId             String?
  group               CategoryGroup?            @relation(fields: [groupId], references: [id])
  objectGroupId       String?
  sortOrder           Int                       @default(0)
  isSystem            Boolean                   @default(false)
  bucketType          String                    @default("uncategorized") // needs | wants | savings | uncategorized
  isTaxDeductible     Boolean                   @default(false)
  excludeFromReports  Boolean                   @default(false)
  isDeleted           Boolean                   @default(false)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  household           Household                 @relation(fields: [householdId], references: [id], onDelete: Cascade)
  objectGroup         ObjectGroup?              @relation(fields: [objectGroupId], references: [id], onDelete: SetNull)
  transactionJournals TransactionJournal[]
  budgets             Budget[]
  recurringItems      RecurringItem[]
  transactionSplits   TransactionSplit[]
  journalsAiSuggested TransactionJournal[]      @relation("JournalAiSuggestedCategory")
  learningExamples    CategoryLearningExample[]

  @@map("categories")
}

model CategoryGroup {
  id          String     @id @default(cuid())
  householdId String
  name        String
  type        String
  sortOrder   Int        @default(0)
  categories  Category[]

  @@map("category_groups")
}

model Budget {
  id               String        @id @default(cuid())
  householdId      String
  categoryId       String?
  name             String? // label for catch-all/uncategorized budgets
  amount           Float
  amountDecimal    Decimal?      @db.Decimal(19, 4)
  period           String        @default("monthly")
  rollover         Boolean       @default(false)
  startDate        DateTime      @default(now())
  budgetType       String        @default("FLEXIBLE") // FIXED | FLEXIBLE | NON_MONTHLY
  autoBudgetType   String?
  autoBudgetAmount Decimal?      @db.Decimal(19, 4)
  groupId          String?
  isDeleted        Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  household        Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  objectGroup      ObjectGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  limits           BudgetLimit[]

  @@map("budgets")
}

model AvailableBudget {
  id           String    @id @default(cuid())
  householdId  String
  amount       Decimal   @db.Decimal(19, 4)
  currencyCode String    @default("USD")
  periodKey    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, periodKey])
  @@map("available_budgets")
}

model Attachment {
  id            String             @id @default(cuid())
  householdId   String
  transactionId String
  filename      String
  mimeType      String
  sizeBytes     Int
  storagePath   String
  uploadedAt    DateTime           @default(now())
  journal       TransactionJournal @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  household     Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("attachments")
}

model BudgetLimit {
  id             String   @id @default(cuid())
  householdId    String
  budgetId       String
  periodKey      String // e.g. "2024-01" for monthly, "2024-W03" for weekly, "2024-Q1" for quarterly
  limitAmount    Decimal  @db.Decimal(19, 4)
  spentAmount    Decimal  @default(0) @db.Decimal(19, 4)
  rolloverAmount Decimal  @default(0) @db.Decimal(19, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  budget         Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, periodKey])
  @@index([householdId, periodKey])
  @@map("budget_limits")
}

model Reconciliation {
  id               String    @id @default(cuid())
  householdId      String
  accountId        String
  statementDate    DateTime
  statementBalance Decimal   @db.Decimal(19, 4)
  openingBalance   Decimal   @db.Decimal(19, 4)
  difference       Decimal   @db.Decimal(19, 4)
  createdAt        DateTime  @default(now())
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, accountId])
  @@map("reconciliations")
}

model Bill {
  id          String           @id @default(cuid())
  householdId String
  name        String
  amountMin   Decimal?         @db.Decimal(19, 4)
  amountMax   Decimal?         @db.Decimal(19, 4)
  currency    String           @default("USD")
  startDate   DateTime
  endDate     DateTime?
  repeatFreq  String
  skipPeriods Int              @default(0)
  isActive    Boolean          @default(true)
  notes       String?
  isDeleted   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  paidPeriods BillPaidPeriod[]
  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("bills")
}

model BillPaidPeriod {
  id            String             @id @default(cuid())
  billId        String
  transactionId String
  periodKey     String
  createdAt     DateTime           @default(now())
  bill          Bill               @relation(fields: [billId], references: [id], onDelete: Cascade)
  journal       TransactionJournal @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([billId, periodKey])
  @@map("bill_paid_periods")
}

model RecurringItem {
  id              String    @id @default(cuid())
  householdId     String
  name            String
  amount          Float
  amountDecimal   Decimal?  @db.Decimal(19, 4)
  frequency       String
  nextDate        DateTime
  accountId       String
  categoryId      String?
  isAutopay       Boolean   @default(false)
  isActive        Boolean   @default(true)
  isDeleted       Boolean   @default(false)
  lastProcessedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account         Account   @relation(fields: [accountId], references: [id])
  category        Category? @relation(fields: [categoryId], references: [id])

  @@map("recurring_items")
}

model Goal {
  id                         String           @id @default(cuid())
  householdId                String
  name                       String
  type                       String
  targetAmount               Float
  targetAmountDecimal        Decimal?         @db.Decimal(19, 4)
  currentAmount              Float            @default(0)
  currentAmountDecimal       Decimal?         @db.Decimal(19, 4)
  targetDate                 DateTime?
  monthlyContribution        Float            @default(0)
  monthlyContributionDecimal Decimal?         @db.Decimal(19, 4)
  accountId                  String?
  icon                       String?
  imageUrl                   String?
  isDeleted                  Boolean          @default(false)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  household                  Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account                    Account?         @relation(fields: [accountId], references: [id])
  allocations                GoalAllocation[]

  @@map("goals")
}

model GoalAllocation {
  id            String             @id @default(cuid())
  goalId        String
  transactionId String
  amount        Float
  amountDecimal Decimal?           @db.Decimal(19, 4)
  goal          Goal               @relation(fields: [goalId], references: [id], onDelete: Cascade)
  journal       TransactionJournal @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("goal_allocations")
}

model InvestmentHolding {
  id                   String                @id @default(cuid())
  accountId            String
  symbol               String
  name                 String
  shares               Float
  sharesDecimal        Decimal?              @db.Decimal(19, 4)
  costBasis            Float
  costBasisDecimal     Decimal?              @db.Decimal(19, 4)
  currentPrice         Float
  currentPriceDecimal  Decimal?              @db.Decimal(19, 4)
  assetClass           String                @default("us_stock")
  priceHistory         Json?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  account              Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lots                 HoldingLot[]
  recurringInvestments RecurringInvestment[]

  @@map("investment_holdings")
}

model HoldingLot {
  id                   String            @id @default(cuid())
  holdingId            String
  date                 DateTime          @default(now())
  shares               Float
  sharesDecimal        Decimal?          @db.Decimal(19, 4)
  pricePerShare        Float
  pricePerShareDecimal Decimal?          @db.Decimal(19, 4)
  note                 String?
  status               String            @default("confirmed") // "confirmed" | "pending"
  createdAt            DateTime          @default(now())
  holding              InvestmentHolding @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  @@map("holding_lots")
}

model RecurringInvestment {
  id            String            @id @default(cuid())
  holdingId     String
  amount        Float
  amountDecimal Decimal?          @db.Decimal(19, 4)
  frequency     String // "weekly" | "biweekly" | "monthly" | "quarterly"
  dayOfMonth    Int               @default(1)
  status        String            @default("active") // "active" | "paused"
  lastRunAt     DateTime?
  nextRunAt     DateTime
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  holding       InvestmentHolding @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  @@map("recurring_investments")
}

model ManualAsset {
  id                   String                @id @default(cuid())
  householdId          String
  name                 String
  type                 String                @default("other") // real_estate | vehicle | crypto | collectible | other
  currentValue         Float
  currentValueDecimal  Decimal?              @db.Decimal(19, 4)
  purchaseValue        Float?
  purchaseValueDecimal Decimal?              @db.Decimal(19, 4)
  purchaseDate         DateTime?
  notes                String?
  currency             String                @default("USD")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  household            Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  snapshots            ManualAssetSnapshot[]

  @@index([householdId])
  @@map("manual_assets")
}

model ManualLiability {
  id                    String    @id @default(cuid())
  householdId           String
  name                  String
  type                  String    @default("other") // mortgage | auto_loan | student_loan | credit_card | other
  originalAmount        Float
  originalAmountDecimal Decimal?  @db.Decimal(19, 4)
  currentBalance        Float
  currentBalanceDecimal Decimal?  @db.Decimal(19, 4)
  interestRate          Float?
  interestRateDecimal   Decimal?  @db.Decimal(19, 4)
  monthlyPayment        Float?
  monthlyPaymentDecimal Decimal?  @db.Decimal(19, 4)
  maturityDate          DateTime?
  notes                 String?
  currency              String    @default("USD")

  // Amortization metadata (all nullable — zero risk to existing rows)
  region            String? // 'US' | 'CA'
  rateType          String? // 'fixed' | 'variable'
  primeRate         Float? // lender prime rate (variable only, e.g. 6.70)
  primeDiscount     Float? // discount off prime (variable only, e.g. 0.90)
  termStartDate     DateTime?
  termEndDate       DateTime? // renewal / balloon date
  amortizationYears Int? // e.g. 25 or 30
  paymentFrequency  String? // 'monthly' | 'biweekly' | 'weekly'

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("manual_liabilities")
}

model TaxAccount {
  id                      String    @id @default(cuid())
  householdId             String
  name                    String
  type                    String // "TFSA" | "RRSP" | "FHSA" | "RESP" | "401k" | "IRA"
  linkedAccountId         String? // FK to Account (optional)
  memberName              String? // household member name for display
  birthYear               Int? // for TFSA age-gating (must be 18+)
  annualRoomCad           Float     @default(0) // CRA-set room for current year
  annualRoomCadDecimal    Decimal?  @db.Decimal(19, 4)
  totalRoomEver           Float     @default(0) // cumulative room since account type inception
  totalRoomEverDecimal    Decimal?  @db.Decimal(19, 4)
  contributionsYtd        Float     @default(0) // contributions this calendar year
  contributionsYtdDecimal Decimal?  @db.Decimal(19, 4)
  withdrawalsYtd          Float     @default(0) // withdrawals (TFSA room restored next Jan 1)
  withdrawalsYtdDecimal   Decimal?  @db.Decimal(19, 4)
  notes                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  household               Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  linkedAccount           Account?  @relation(fields: [linkedAccountId], references: [id])

  @@index([householdId])
  @@map("tax_accounts")
}

model ManualAssetSnapshot {
  id           String      @id @default(cuid())
  assetId      String
  value        Float
  valueDecimal Decimal?    @db.Decimal(19, 4)
  date         DateTime    @default(now())
  asset        ManualAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, date])
  @@map("manual_asset_snapshots")
}

model Merchant {
  id          String               @id @default(cuid())
  householdId String
  name        String
  displayName String
  logoUrl     String?
  createdAt   DateTime             @default(now())
  household   Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  journals    TransactionJournal[]

  @@map("merchants")
}

model Tag {
  id              String           @id @default(cuid())
  householdId     String
  name            String
  color           String           @default("#6366f1")
  createdAt       DateTime         @default(now())
  household       Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactionTags TransactionTag[]
  journalTags     JournalTag[]

  @@map("tags")
}

model TransactionTag {
  transactionId String
  tagId         String
  journal       TransactionJournal @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag           Tag                @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@map("transaction_tags")
}

model JournalTag {
  journalId String
  tagId     String
  journal   TransactionJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  tag       Tag                @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([journalId, tagId])
  @@map("journal_tags")
}

model RuleGroup {
  id             String    @id @default(cuid())
  householdId    String
  name           String
  sortOrder      Int       @default(0)
  stopProcessing Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  rules          Rule[]
  household      Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("rule_groups")
}

model Rule {
  id             String             @id @default(cuid())
  householdId    String
  name           String?
  conditions     Json
  actions        Json
  strict         Boolean            @default(true)
  stopProcessing Boolean            @default(false)
  sortOrder      Int                @default(0)
  isActive       Boolean            @default(true)
  ruleGroupId    String?
  ruleGroup      RuleGroup?         @relation(fields: [ruleGroupId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  household      Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  triggers       RuleTrigger[]
  ruleActions    RuleActionRecord[]
  executionLogs  RuleExecutionLog[]

  @@index([householdId, isActive, sortOrder])
  @@index([ruleGroupId])
  @@map("rules")
}

model RuleTrigger {
  id        String   @id @default(cuid())
  ruleId    String
  field     String
  operator  String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rule      Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, sortOrder])
  @@map("rule_triggers")
}

model RuleActionRecord {
  id             String   @id @default(cuid())
  ruleId         String
  type           String
  value          String?
  sortOrder      Int      @default(0)
  stopProcessing Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  rule           Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, sortOrder])
  @@map("rule_actions")
}

model RuleExecutionLog {
  id             String             @id @default(cuid())
  householdId    String
  ruleId         String
  journalId      String
  status         String             @default("applied")
  actionsApplied Int                @default(0)
  message        String?
  createdAt      DateTime           @default(now())
  household      Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  rule           Rule               @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  journal        TransactionJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt])
  @@index([ruleId, createdAt])
  @@index([journalId, createdAt])
  @@map("rule_execution_logs")
}

model CategoryLearningExample {
  id                 String    @id @default(cuid())
  householdId        String
  descriptionPattern String
  correctCategoryId  String
  correctCategory    Category  @relation(fields: [correctCategoryId], references: [id], onDelete: Cascade)
  household          Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([householdId])
  @@map("category_learning_examples")
}

model Notification {
  id               String    @id @default(cuid())
  householdId      String
  userId           String?
  type             String // "anomaly" | "subscription" | "missed_payment" | "over_budget" | "info"
  severity         String    @default("info") // "info" | "warning" | "alert"
  title            String
  body             String
  read             Boolean   @default(false)
  linkedEntityId   String? // transaction ID, account ID, etc.
  linkedEntityType String? // "transaction" | "account" | "goal"
  createdAt        DateTime  @default(now())
  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, read, createdAt])
  @@map("notifications")
}

model UserPreference {
