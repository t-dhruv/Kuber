generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String            @id @default(cuid())
  email               String            @unique
  passwordHash        String
  firstName           String
  lastName            String
  avatar              String?
  timezone            String            @default("America/New_York")
  theme               String            @default("system")
  // 2FA
  totpSecret          String?
  totpEnabled         Boolean           @default(false)
  backupCodes         String[]          @default([])
  // Account lockout
  failedLoginAttempts Int               @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  householdMembers    HouseholdMember[]
  preferences         UserPreference[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]

  @@map("users")
}

model Household {
  id                      String                   @id @default(cuid())
  name                    String
  currency                String                   @default("USD")
  fiscalYearStart         Int                      @default(1)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  members                 HouseholdMember[]
  accounts                Account[]
  categories              Category[]
  budgets                 Budget[]
  recurringItems          RecurringItem[]
  goals                   Goal[]
  rules                   Rule[]
  merchants               Merchant[]
  tags                    Tag[]
  invites                 HouseholdInvite[]
  aiConfig                AiConfig?
  conversations           Conversation[]
  netWorthSnapshots       NetWorthSnapshot[]
  accountBalanceSnapshots AccountBalanceSnapshot[]
  savedReports            SavedReport[]
  wealthAiCache           WealthAiCache?
  duplicateDismissals     DuplicateDismissal[]
  reportSchedule          ReportSchedule?
  importHistory           ImportHistory[]
  operationCheckpoints    OperationCheckpoint[]
  notifications           Notification[]
  manualAssets            ManualAsset[]
  manualLiabilities       ManualLiability[]
  taxAccounts             TaxAccount[]

  @@map("households")
}

model AiConfig {
  id              String    @id @default(cuid())
  householdId     String    @unique
  provider        String    @default("none") // "anthropic"|"openai"|"gemini"|"openrouter"|"none"
  model           String    @default("")
  encryptedApiKey String    @default("")
  baseUrl         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("ai_configs")
}

model Conversation {
  id          String                @id @default(cuid())
  householdId String
  userId      String
  title       String                @default("New conversation")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  messages    ConversationMessage[]
  household   Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, updatedAt])
  @@map("conversations")
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  role           String // "user"|"assistant"|"system"
  content        String
  tokenCount     Int?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

model HouseholdMember {
  id          String    @id @default(cuid())
  userId      String
  householdId String
  role        String    @default("member")
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@map("household_members")
}

model HouseholdInvite {
  id          String    @id @default(cuid())
  householdId String
  email       String
  token       String    @unique @default(cuid())
  role        String    @default("member")
  expiresAt   DateTime
  usedAt      DateTime?
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("household_invites")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique // SHA-256 of the raw token
  familyId  String // shared across all rotations in a session
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}

model Account {
  id                  String                   @id @default(cuid())
  householdId         String
  name                String
  type                String
  institution         String?
  institutionLogo     String?
  lastFour            String?
  balance             Float                    @default(0)
  currency            String                   @default("USD")
  isHidden            Boolean                  @default(false)
  excludeFromNetWorth Boolean                  @default(false)
  lastSynced          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  household           Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions        Transaction[]
  recurringItems      RecurringItem[]
  goals               Goal[]
  investmentHoldings  InvestmentHolding[]
  balanceSnapshots    AccountBalanceSnapshot[]
  taxAccounts         TaxAccount[]

  @@map("accounts")
}

model Transaction {
  id                  String           @id @default(cuid())
  householdId         String
  accountId           String
  date                DateTime
  description         String
  originalDescription String
  amount              Float
  categoryId          String?
  merchantId          String?
  notes               String?
  isRecurring         Boolean          @default(false)
  needsReview         Boolean          @default(false)
  isHidden            Boolean          @default(false)
  isPending           Boolean          @default(false)
  isSplit             Boolean          @default(false)
  splitDetails        Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  account             Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category            Category?        @relation(fields: [categoryId], references: [id])
  merchant            Merchant?        @relation(fields: [merchantId], references: [id])
  tags                TransactionTag[]
  goalAllocations     GoalAllocation[]

  @@index([householdId, date])
  @@index([householdId, date, amount])
  @@index([accountId])
  @@index([categoryId])
  @@map("transactions")
}

model Category {
  id             String          @id @default(cuid())
  householdId    String
  name           String
  emoji          String?
  type           String
  groupId        String?
  group          CategoryGroup?  @relation(fields: [groupId], references: [id])
  sortOrder      Int             @default(0)
  isSystem          Boolean         @default(false)
  bucketType        String          @default("uncategorized") // needs | wants | savings | uncategorized
  isTaxDeductible   Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  household      Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  budgets        Budget[]
  recurringItems RecurringItem[]

  @@map("categories")
}

model CategoryGroup {
  id          String     @id @default(cuid())
  householdId String
  name        String
  type        String
  sortOrder   Int        @default(0)
  categories  Category[]

  @@map("category_groups")
}

model Budget {
  id          String    @id @default(cuid())
  householdId String
  categoryId  String
  amount      Float
  period      String    @default("monthly")
  rollover    Boolean   @default(false)
  startDate   DateTime  @default(now())
  budgetType  String    @default("FLEXIBLE") // FIXED | FLEXIBLE | NON_MONTHLY
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, categoryId])
  @@map("budgets")
}

model RecurringItem {
  id          String    @id @default(cuid())
  householdId String
  name        String
  amount      Float
  frequency   String
  nextDate    DateTime
  accountId   String
  categoryId  String?
  isAutopay   Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account     Account   @relation(fields: [accountId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id])

  @@map("recurring_items")
}

model Goal {
  id                  String           @id @default(cuid())
  householdId         String
  name                String
  type                String
  targetAmount        Float
  currentAmount       Float            @default(0)
  targetDate          DateTime?
  monthlyContribution Float            @default(0)
  accountId           String?
  icon                String?
  imageUrl            String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  household           Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account             Account?         @relation(fields: [accountId], references: [id])
  allocations         GoalAllocation[]

  @@map("goals")
}

model GoalAllocation {
  id            String      @id @default(cuid())
  goalId        String
  transactionId String
  amount        Float
  goal          Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("goal_allocations")
}

model InvestmentHolding {
  id                   String                @id @default(cuid())
  accountId            String
  symbol               String
  name                 String
  shares               Float
  costBasis            Float
  currentPrice         Float
  assetClass           String                @default("us_stock")
  priceHistory         Json?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  account              Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lots                 HoldingLot[]
  recurringInvestments RecurringInvestment[]

  @@map("investment_holdings")
}

model HoldingLot {
  id            String            @id @default(cuid())
  holdingId     String
  date          DateTime          @default(now())
  shares        Float
  pricePerShare Float
  note          String?
  status        String            @default("confirmed") // "confirmed" | "pending"
  createdAt     DateTime          @default(now())
  holding       InvestmentHolding @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  @@map("holding_lots")
}

model RecurringInvestment {
  id         String            @id @default(cuid())
  holdingId  String
  amount     Float
  frequency  String // "weekly" | "biweekly" | "monthly" | "quarterly"
  dayOfMonth Int               @default(1)
  status     String            @default("active") // "active" | "paused"
  lastRunAt  DateTime?
  nextRunAt  DateTime
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  holding    InvestmentHolding @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  @@map("recurring_investments")
}

model ManualAsset {
  id            String               @id @default(cuid())
  householdId   String
  name          String
  type          String               @default("other") // real_estate | vehicle | crypto | collectible | other
  currentValue  Float
  purchaseValue Float?
  purchaseDate  DateTime?
  notes         String?
  currency      String               @default("USD")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  household     Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  snapshots     ManualAssetSnapshot[]

  @@index([householdId])
  @@map("manual_assets")
}

model ManualLiability {
  id              String   @id @default(cuid())
  householdId     String
  name            String
  type            String   @default("other") // mortgage | auto_loan | student_loan | credit_card | other
  originalAmount  Float
  currentBalance  Float
  interestRate    Float?
  monthlyPayment  Float?
  maturityDate    DateTime?
  notes           String?
  currency        String   @default("USD")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("manual_liabilities")
}

model TaxAccount {
  id               String    @id @default(cuid())
  householdId      String
  name             String
  type             String          // "TFSA" | "RRSP" | "FHSA" | "RESP" | "401k" | "IRA"
  linkedAccountId  String?         // FK to Account (optional)
  memberName       String?         // household member name for display
  birthYear        Int?            // for TFSA age-gating (must be 18+)
  annualRoomCad    Float           @default(0)  // CRA-set room for current year
  totalRoomEver    Float           @default(0)  // cumulative room since account type inception
  contributionsYtd Float           @default(0)  // contributions this calendar year
  withdrawalsYtd   Float           @default(0)  // withdrawals (TFSA room restored next Jan 1)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  household        Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  linkedAccount    Account?        @relation(fields: [linkedAccountId], references: [id])

  @@index([householdId])
  @@map("tax_accounts")
}

model ManualAssetSnapshot {
  id        String      @id @default(cuid())
  assetId   String
  value     Float
  date      DateTime    @default(now())
  asset     ManualAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, date])
  @@map("manual_asset_snapshots")
}

model Merchant {
  id           String        @id @default(cuid())
  householdId  String
  name         String
  displayName  String
  logoUrl      String?
  createdAt    DateTime      @default(now())
  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("merchants")
}

model Tag {
  id              String           @id @default(cuid())
  householdId     String
  name            String
  color           String           @default("#6366f1")
  createdAt       DateTime         @default(now())
  household       Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactionTags TransactionTag[]

  @@map("tags")
}

model TransactionTag {
  transactionId String
  tagId         String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@map("transaction_tags")
}

model Rule {
  id          String    @id @default(cuid())
  householdId String
  conditions  Json
  actions     Json
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("rules")
}

model Notification {
  id               String    @id @default(cuid())
  householdId      String
  userId           String?
  type             String    // "anomaly" | "subscription" | "missed_payment" | "over_budget" | "info"
  severity         String    @default("info") // "info" | "warning" | "alert"
  title            String
  body             String
  read             Boolean   @default(false)
  linkedEntityId   String?   // transaction ID, account ID, etc.
  linkedEntityType String?   // "transaction" | "account" | "goal"
  createdAt        DateTime  @default(now())
  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, read, createdAt])
  @@map("notifications")
}

model UserPreference {
  userId String
  key    String
  value  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@map("user_preferences")
}

model NetWorthSnapshot {
  id          String    @id @default(cuid())
  householdId String
  date        DateTime  @db.Date
  assets      Float
  liabilities Float
  netWorth    Float
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, date])
  @@index([householdId, date])
  @@map("net_worth_snapshots")
}

model AdviceTopic {
  id          String               @id @default(cuid())
  slug        String               @unique
  title       String
  description String
  category    String
  icon        String
  sortOrder   Int                  @default(0)
  tasks       AdviceTask[]
  progress    UserAdviceProgress[]

  @@map("advice_topics")
}

model AdviceTask {
  id          String               @id @default(cuid())
  topicId     String
  title       String
  description String
  sortOrder   Int                  @default(0)
  topic       AdviceTopic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress    UserAdviceProgress[]

  @@map("advice_tasks")
}

model UserAdviceProgress {
  id          String      @id @default(cuid())
  householdId String
  topicId     String
  taskId      String
  completedAt DateTime    @default(now())
  topic       AdviceTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  task        AdviceTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([householdId, taskId])
  @@map("user_advice_progress")
}

model SavedReport {
  id          String    @id @default(cuid())
  householdId String
  name        String
  filters     Json // { tab, datePreset, startDate, endDate }
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("saved_reports")
}

model AuditLog {
  id          String   @id @default(cuid())
  householdId String
  userId      String
  action      String // CREATE | UPDATE | DELETE
  entity      String // TRANSACTION | ACCOUNT | BUDGET | GOAL | RULE
  entityId    String
  changes     Json? // { before: {...}, after: {...} }
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model WealthAiCache {
  id          String    @id @default(cuid())
  householdId String    @unique
  analysis    String    @db.Text
  generatedAt DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id])

  @@map("wealth_ai_cache")
}

model DuplicateDismissal {
  id             String    @id @default(cuid())
  householdId    String
  transactionId1 String
  transactionId2 String
  createdAt      DateTime  @default(now())
  household      Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([transactionId1, transactionId2])
  @@map("duplicate_dismissals")
}

model AccountBalanceSnapshot {
  id          String    @id @default(cuid())
  accountId   String
  householdId String
  date        DateTime  @db.Date
  balance     Float
  createdAt   DateTime  @default(now())
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
  @@index([householdId, date])
  @@map("account_balance_snapshots")
}

model ReportSchedule {
  id          String    @id @default(cuid())
  householdId String    @unique
  userId      String
  frequency   String    @default("weekly") // 'weekly' | 'monthly'
  enabled     Boolean   @default(false)
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("report_schedules")
}

model ImportHistory {
  id            String    @id @default(cuid())
  householdId   String
  filename      String
  bankSource    String?
  rowsTotal     Int
  rowsImported  Int
  rowsDuplicate Int       @default(0)
  rowsSkipped   Int       @default(0)
  status        String    @default("completed") // completed | partial | failed
  createdAt     DateTime  @default(now())
  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt])
  @@map("import_history")
}

model OperationCheckpoint {
  id          String   @id @default(cuid())
  householdId String
  type        String   // "bulk-import" | "rule-apply-all" | "bulk-categorize" | "bulk-delete"
  label       String   // human-readable description e.g. "Imported 47 rows from td-statement.csv"
  snapshot    Json     // array of { id, amount, description, categoryId, merchantId, isHidden, date }
  txnCount    Int
  rolledBack  Boolean  @default(false)
  expiresAt   DateTime // now + 7 days
  createdAt   DateTime @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt])
  @@map("operation_checkpoints")
}
