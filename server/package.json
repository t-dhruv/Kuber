{
  "name": "@kuber/server",
  "private": true,
  "version": "1.1.0-beta",
  "scripts": {
    "dev": "dotenv -e ../.env -- tsx watch src/index.ts",
    "build": "dotenv -e ../.env -- tsc",
    "start": "dotenv -e ../.env -- node dist/index.js",
    "lint": "dotenv -e ../.env -- eslint .",
    "typecheck": "dotenv -e ../.env -- tsc --noEmit",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../.env -- prisma studio",
    "db:generate": "dotenv -e ../.env -- prisma generate",
    "test": "dotenv -e ../.env -- vitest run",
    "test:db": "dotenv -e ../.env -- vitest run --config vitest.db.config.ts",
    "test:coverage": "dotenv -e ../.env -- vitest run --coverage --maxWorkers=1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@google/generative-ai": "^0.24.1",
    "@kuber/shared": "*",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "imapflow": "^1.3.3",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.6.0",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "openai": "^7.3.0",
    "otplib": "^13.4.0",
    "pdfkit": "^0.18.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-loki": "^3.0.0",
    "prisma": "^7.9.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "resend": "^6.1.3",
    "web-push": "^3.6.7",
    "yahoo-finance2": "^4.0.0",
    "zod": "^4.4.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mailparser": "^3.4.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv-cli": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5"
  }
}
