{
  "name": "@kuber/server",
  "private": true,
  "version": "1.0.0-beta",
  "scripts": {
    "dev": "node ../scripts/run-with-root-env.mjs --cwd server tsx watch src/index.ts",
    "build": "node ../scripts/run-with-root-env.mjs --cwd server tsc",
    "start": "node ../scripts/run-with-root-env.mjs --cwd server node dist/index.js",
    "lint": "node ../scripts/run-with-root-env.mjs --cwd server eslint .",
    "db:migrate": "node ../scripts/run-with-root-env.mjs --cwd server prisma migrate dev",
    "db:seed": "node ../scripts/run-with-root-env.mjs --cwd server tsx prisma/seed.ts",
    "db:studio": "node ../scripts/run-with-root-env.mjs --cwd server prisma studio",
    "db:generate": "node ../scripts/run-with-root-env.mjs --cwd server prisma generate",
    "test": "node ../scripts/run-with-root-env.mjs --cwd server vitest run",
    "test:coverage": "node ../scripts/run-with-root-env.mjs --cwd server vitest run --coverage --maxWorkers=1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@google/generative-ai": "^0.24.1",
    "@kuber/shared": "*",
    "@prisma/client": "^5.16.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "exceljs": "^3.10.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "imapflow": "^1.3.6",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.9",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "openai": "^6.42.0",
    "otplib": "^13.4.1",
    "pdfkit": "^0.19.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-loki": "^3.0.0",
    "prisma": "^5.16.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "resend": "^6.12.4",
    "web-push": "^3.6.7",
    "yahoo-finance2": "^3.15.2",
    "zod": "^3.23.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mailparser": "^3.4.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.42",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.8",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^5.5.3",
    "vitest": "^4.1.5"
  }
}
